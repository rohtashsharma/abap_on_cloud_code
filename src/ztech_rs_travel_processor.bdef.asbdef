projection;
strict ( 2 );
use side effects;
//use draft;
use collaborative draft;

define behavior for ZTECH_RS_TRAVEL_PROCESSOR alias Travel
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Edit;
  use action Resume;
  use action Prepare;
  use action Discard;
  use action Share;

  use action validateCustomer;

  use action copyTravel;

  use association _Booking { create; with draft; }
}

define behavior for ZTECH_RS_BOOKING_PROCESSOR //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _BookingSuppl { create; with draft; }
}

define behavior for ZTECH_RS_BOOKSUPP_PROCESSOR alias BookSupppl
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _Booking { with draft; }
}